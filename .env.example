# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/furnitureos?sslmode=require"

# JWT Authentication Secrets
JWT_SECRET="furnitureos_jwt_super_secret_key_change_in_production_2026"
JWT_REFRESH_SECRET="furnitureos_jwt_refresh_super_secret_key_change_in_production_2026"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Port & Environment
PORT=4000
NODE_ENV=development
API_URL="http://localhost:4000"

# CORS Allowed Origin
CORS_ORIGIN="http://localhost:3000"

# Frontend Next.js Config
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
