# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require&connection_limit=10&connect_timeout=30"

# JWT Authentication Secrets (Must be custom 32+ char secrets in production)
JWT_SECRET="your_production_jwt_secret_min_32_characters_long_key_here"
JWT_REFRESH_SECRET="your_production_jwt_refresh_secret_min_32_characters_long_key_here"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Port & Environment
PORT=4000
NODE_ENV=production
API_URL="https://api.furnitureos.com"
VERSION="1.0.0"
LOG_LEVEL="info"

# CORS Allowed Origin (Comma-separated for multiple allowed origins, no wildcards in prod)
CORS_ORIGIN="https://app.furnitureos.com,https://admin.furnitureos.com"

# Frontend Next.js Public Config
NEXT_PUBLIC_API_URL="https://api.furnitureos.com/api/v1"

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Cloudflare R2 Object Storage (Company Profile & Tenant Branding)
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_cloudflare_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_cloudflare_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="furniture-os-branding"
CLOUDFLARE_R2_PUBLIC_URL="https://cdn.furnitureos.com"

# Optional Redis Cache (Upstash Redis)
REDIS_URL="rediss://default:password@sample.upstash.io:6379"


