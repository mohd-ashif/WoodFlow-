  MAKE_TO_STOCK
  MAKE_TO_ORDER
  CUSTOM_PRODUCT
}

enum CustomerDesignStatus {
  DRAFT
  DESIGNING
  APPROVAL_PENDING
  APPROVED
  REJECTED
  CONVERTED_TO_ORDER
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CONVERTED
}

enum DemandSourceType {
  SALES_ORDER
  REORDER
  MANUAL
  PRODUCTION_PLAN
}

enum DemandStatus {
  PENDING
  MRP_PROCESSED
  IN_PRODUCTION
  FULFILLED
  CANCELLED
}

enum MRPRequirementStatus {
  READY
  PARTIAL
  SHORTAGE
  PURCHASE_REQUIRED
  ORDERED
  FULFILLED
}

enum ReservationStatus {
  RESERVED
  ALLOCATED
  RELEASED
  CONSUMED
