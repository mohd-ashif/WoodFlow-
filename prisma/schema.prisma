generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  PLATFORM_ADMIN
  COMPANY
}

enum CompanyRole {
  OWNER
  MANAGER
  STAFF
  WORKER
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ProductType {
  FINISHED_PRODUCT
  RAW_MATERIAL
}

enum StockMovementType {
  OPENING_STOCK
  STOCK_ADJUSTMENT_IN
  STOCK_ADJUSTMENT_OUT
  STOCK_CORRECTION
  DAMAGE
  LOST
  INITIAL_IMPORT
  PURCHASE
  SALE
  SALES_RETURN
  PURCHASE_RETURN
  PRODUCTION_IN
  MATERIAL_CONSUMPTION
  PRODUCTION_ISSUE
  PRODUCTION_RETURN
  PRODUCTION_OUTPUT
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  phone        String?
  systemRole   SystemRole  @default(COMPANY)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  lastLoginAt  DateTime?

  memberships      CompanyMember[]
  accessRequests   AccessRequest[] @relation("UserAccessRequests")
  reviewedRequests AccessRequest[] @relation("AdminReviewedRequests")
  auditLogs        AuditLog[]
  stockMovements   StockMovement[]
  customersCreated Customer[]      @relation("CustomerCreatedBy")
  suppliersCreated Supplier[]      @relation("SupplierCreatedBy")
  customerNotes    CustomerNote[]
  supplierNotes    SupplierNote[]
  crmActivities    CRMActivity[]
  salesCreated     Sale[]          @relation("SaleCreatedBy")
  purchasesCreated Purchase[]      @relation("PurchaseCreatedBy")
  workOrdersCreated WorkOrder[]    @relation("WorkOrderCreatedBy")
  financialTxCreated      FinancialTransaction[] @relation("FinancialTxCreatedBy")
  customerPaymentsCreated CustomerPayment[]      @relation("CustomerPaymentCreatedBy")
  supplierPaymentsCreated SupplierPayment[]      @relation("SupplierPaymentCreatedBy")
  expensesCreated         Expense[]              @relation("ExpenseCreatedBy")
  transfersCreated        AccountTransfer[]      @relation("AccountTransferCreatedBy")

  @@map("users")
}

model Company {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  logo               String?
  email              String?
  phone              String?
  address            String?
  city               String?
  state              String?
  country            String?
  postalCode         String?
  gstNumber          String?
  status             CompanyStatus   @default(ACTIVE)
  allowNegativeStock Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  members           CompanyMember[]
  auditLogs         AuditLog[]
  categories        Category[]
  units             Unit[]
  products          Product[]
  inventories       Inventory[]
  stockMovements    StockMovement[]
  customers         Customer[]
  customerAddresses CustomerAddress[]
  customerNotes     CustomerNote[]
  suppliers         Supplier[]
  supplierAddresses SupplierAddress[]
  supplierNotes     SupplierNote[]
  crmActivities     CRMActivity[]
  tags              Tag[]
  sales             Sale[]
  invoices          Invoice[]
  purchases         Purchase[]
  departments       Department[]
  workers           Worker[]
  workOrders        WorkOrder[]
  workOrderMaterials WorkOrderMaterial[]
  qualityChecks     QualityCheck[]
  workerAttendances WorkerAttendance[]
  paymentAccounts      PaymentAccount[]
  financialTransactions FinancialTransaction[]
  customerPayments     CustomerPayment[]
  supplierPayments     SupplierPayment[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  accountTransfers     AccountTransfer[]

  @@map("companies")
}

model CompanyMember {
  id        String       @id @default(cuid())
  userId    String
  companyId String
  role      CompanyRole  @default(MEMBER)
  status    MemberStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("company_members")
}

model AccessRequest {
  id                   String              @id @default(cuid())
  userId               String
  requestedCompanyName String
  message              String?
  status               AccessRequestStatus @default(PENDING)
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user     User  @relation("UserAccessRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("AdminReviewedRequests", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("access_requests")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  companyId String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Product {
  id            String      @id @default(cuid())
  companyId     String
  name          String
  sku           String
  description   String?
  productType   ProductType
  categoryId    String
  unitId        String
  purchasePrice Float       @default(0)
  sellingPrice  Float       @default(0)
  minimumStock  Float       @default(0)
  openingStock  Float       @default(0)
  currentStock  Float       @default(0)
  imageUrl      String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category  Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit      Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  inventory Inventory?
  movements StockMovement[]
  saleItems SaleItem[]
  purchaseItems PurchaseItem[]
  workOrderItems WorkOrderItem[]
  workOrderMaterials WorkOrderMaterial[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, categoryId])
  @@index([companyId, productType])
  @@map("products")
}

model Category {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("categories")
}

model Unit {
  id        String    @id @default(cuid())
  companyId String
  name      String
  shortCode String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@unique([companyId, shortCode])
  @@index([companyId])
  @@map("units")
}

model Inventory {
  id                String   @id @default(cuid())
  companyId         String
  productId         String   @unique
  currentQuantity   Float    @default(0)
  reservedQuantity  Float    @default(0)
  availableQuantity Float    @default(0)
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, productId])
  @@map("inventories")
}

model StockMovement {
  id               String            @id @default(cuid())
  companyId        String
  productId        String
  movementType     StockMovementType
  quantity         Float
  previousQuantity Float
  newQuantity      Float
  referenceType    String?
  referenceId      String?
  reason           String?
  notes            String?
  createdBy        String?
  createdAt        DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, productId])
  @@index([companyId, createdAt])
  @@index([companyId, movementType])
  @@map("stock_movements")
}

// CRM ENUMS & MODELS
enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum CustomerAddressType {
  HOME
  OFFICE
  DELIVERY
  OTHER
}

enum SupplierAddressType {
  OFFICE
  WAREHOUSE
  BILLING
  OTHER
}

enum CRMEntityType {
  CUSTOMER
  SUPPLIER
}

enum CRMActivityType {
  NOTE
  CALL
  EMAIL
  FOLLOW_UP
  STATUS_CHANGE
  CREATED
  UPDATED
  ARCHIVED
  RESTORED
}

enum TagType {
  CUSTOMER
  SUPPLIER
}

model Customer {
  id             String         @id @default(cuid())
  companyId      String
  customerCode   String
  name           String
  phone          String
  alternatePhone String?
  email          String?
  dateOfBirth    DateTime?
  gstNumber      String?
  taxId          String?
  notes          String?
  status         CustomerStatus @default(ACTIVE)
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator   User?             @relation("CustomerCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  addresses CustomerAddress[]
  notesList CustomerNote[]
  tags      CustomerTag[]
  sales     Sale[]
  invoices  Invoice[]
  workOrders WorkOrder[]
  customerPayments CustomerPayment[]

  @@unique([companyId, customerCode])
  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, phone])
  @@index([companyId, email])
  @@index([companyId, customerCode])
  @@index([companyId, status])
  @@map("customers")
}

model CustomerAddress {
  id           String              @id @default(cuid())
  customerId   String
  companyId    String
  type         CustomerAddressType @default(HOME)
  name         String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String              @default("India")
  isDefault    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([customerId])
  @@index([companyId, customerId])
  @@map("customer_addresses")
}

model CustomerNote {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  content    String
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creator  User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([customerId])
  @@map("customer_notes")
}

model Supplier {
  id             String         @id @default(cuid())
  companyId      String
  supplierCode   String
  name           String
  phone          String
  alternatePhone String?
  email          String?
  gstNumber      String?
  taxId          String?
  notes          String?
  status         SupplierStatus @default(ACTIVE)
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator   User?             @relation("SupplierCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  addresses SupplierAddress[]
  notesList SupplierNote[]
  tags      SupplierTag[]
  purchases Purchase[]
  supplierPayments SupplierPayment[]

  @@unique([companyId, supplierCode])
  @@index([companyId])
  @@index([companyId, name])
  @@index([companyId, phone])
  @@index([companyId, email])
  @@index([companyId, supplierCode])
  @@index([companyId, status])
  @@map("suppliers")
}

model SupplierAddress {
  id           String              @id @default(cuid())
  supplierId   String
  companyId    String
  type         SupplierAddressType @default(OFFICE)
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String              @default("India")
  isDefault    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([supplierId])
  @@index([companyId, supplierId])
  @@map("supplier_addresses")
}

model SupplierNote {
  id         String   @id @default(cuid())
  companyId  String
  supplierId String
  content    String
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  creator  User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([supplierId])
  @@map("supplier_notes")
}

model CRMActivity {
  id           String          @id @default(cuid())
  companyId    String
  entityType   CRMEntityType
  entityId     String
  activityType CRMActivityType
  title        String
  description  String?
  createdBy    String?
  createdAt    DateTime        @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  @@map("crm_activities")
}

model Tag {
  id        String   @id @default(cuid())
  companyId String
  name      String
  type      TagType
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers CustomerTag[]
  suppliers SupplierTag[]

  @@unique([companyId, name, type])
  @@index([companyId])
  @@map("tags")
}

model CustomerTag {
  customerId String
  tagId      String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tagId])
  @@map("customer_tags")
}

model SupplierTag {
  supplierId String
  tagId      String
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([supplierId, tagId])
  @@index([tagId])
  @@map("supplier_tags")
}

// PHASE 4 — SALES & INVOICING ENUMS & MODELS
enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

model Sale {
  id             String        @id @default(cuid())
  companyId      String
  saleNumber     String
  customerId     String?
  status         SaleStatus    @default(DRAFT)
  subtotal       Float
  discountAmount Float         @default(0)
  taxAmount      Float         @default(0)
  totalAmount    Float
  paidAmount     Float         @default(0)
  dueAmount      Float
  paymentStatus  PaymentStatus @default(UNPAID)
  notes          String?
  billingAddress String?
  saleDate       DateTime      @default(now())
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  creator   User?      @relation("SaleCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  items     SaleItem[]
  invoices  Invoice[]
  customerPayments CustomerPayment[]

  @@unique([companyId, saleNumber])
  @@index([companyId])
  @@index([companyId, customerId])
  @@index([companyId, saleDate])
  @@index([companyId, status])
  @@index([companyId, paymentStatus])
  @@map("sales")
}

model SaleItem {
  id                  String   @id @default(cuid())
  companyId           String
  saleId              String
  productId           String?
  productNameSnapshot String
  skuSnapshot         String
  quantity            Float
  unitPrice           Float
  discountAmount      Float    @default(0)
  taxRate             Float    @default(0)
  taxAmount           Float    @default(0)
  totalAmount         Float
  createdAt           DateTime @default(now())

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Invoice {
  id                     String        @id @default(cuid())
  companyId              String
  saleId                 String
  invoiceNumber          String
  invoiceDate            DateTime      @default(now())
  customerId             String?
  customerNameSnapshot   String
  customerPhoneSnapshot  String?
  customerEmailSnapshot  String?
  billingAddress         String?
  subtotal               Float
  discountAmount         Float         @default(0)
  taxAmount              Float         @default(0)
  totalAmount            Float
  status                 InvoiceStatus @default(ISSUED)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale     Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([companyId, saleId])
  @@index([companyId, customerId])
  @@index([companyId, invoiceDate])
  @@index([companyId, status])
  @@map("invoices")
}

// PHASE 5 — PURCHASE MANAGEMENT ENUMS & MODELS
enum PurchaseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  PARTIALLY_RECEIVED
  RECEIVED
}

model Purchase {
  id              String         @id @default(cuid())
  companyId       String
  purchaseNumber  String
  supplierId      String?
  status          PurchaseStatus @default(DRAFT)
  subtotal        Float
  discountAmount  Float          @default(0)
  taxAmount       Float          @default(0)
  totalAmount     Float
  paidAmount      Float          @default(0)
  dueAmount       Float
  paymentStatus   PaymentStatus  @default(UNPAID)
  notes           String?
  referenceNumber String?
  purchaseDate    DateTime       @default(now())
  createdBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  creator  User?          @relation("PurchaseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  items    PurchaseItem[]
  supplierPayments SupplierPayment[]

  @@unique([companyId, purchaseNumber])
  @@index([companyId])
  @@index([companyId, supplierId])
  @@index([companyId, purchaseDate])
  @@index([companyId, status])
  @@index([companyId, paymentStatus])
  @@map("purchases")
}

model PurchaseItem {
  id                  String   @id @default(cuid())
  companyId           String
  purchaseId          String
  productId           String?
  productNameSnapshot String
  skuSnapshot         String
  quantity            Float
  unitCost            Float
  discountAmount      Float    @default(0)
  taxRate             Float    @default(0)
  taxAmount           Float    @default(0)
  totalAmount         Float
  createdAt           DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// PHASE 6 — WORKERS, WORK ORDERS & FURNITURE PRODUCTION ENUMS & MODELS

enum WorkerStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  DAILY_WAGE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum WorkOrderSourceType {
  SALES_ORDER
  MANUAL
  INTERNAL
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkOrderStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  ON_HOLD
  QUALITY_CHECK
  COMPLETED
  CANCELLED
}

enum TaskStage {
  MATERIAL_PREPARATION
  CUTTING
  CARPENTRY
  ASSEMBLY
  SANDING
  PAINTING
  POLISHING
  UPHOLSTERY
  QUALITY_CHECK
  PACKAGING
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum MaterialStatus {
  PLANNED
  PARTIALLY_ISSUED
  ISSUED
  RETURNED
}

enum QualityStatus {
  PENDING
  PASSED
  FAILED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

model Department {
  id          String           @id @default(cuid())
  companyId   String
  name        String
  description String?
  status      DepartmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workers Worker[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("departments")
}

model Worker {
  id             String         @id @default(cuid())
  companyId      String
  employeeCode   String
  firstName      String
  lastName       String
  phone          String?
  email          String?
  address        String?
  departmentId   String?
  employmentType EmploymentType @default(FULL_TIME)
  joiningDate    DateTime?
  dailyWage      Float?
  monthlySalary  Float?
  status         WorkerStatus   @default(ACTIVE)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company     Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department  Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  skills      WorkerSkill[]
  assignments ProductionTaskAssignment[]
  attendance  WorkerAttendance[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, departmentId])
  @@map("workers")
}

model WorkerSkill {
  id        String   @id @default(cuid())
  workerId  String
  skillName String
  createdAt DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, skillName])
  @@index([workerId])
  @@map("worker_skills")
}

model WorkOrder {
  id              String              @id @default(cuid())
  companyId       String
  workOrderNumber String
  sourceType      WorkOrderSourceType @default(MANUAL)
  sourceId        String?
  customerId      String?
  title           String
  description     String?
  priority        WorkOrderPriority   @default(MEDIUM)
  status          WorkOrderStatus     @default(DRAFT)
  startDate       DateTime?
  dueDate         DateTime?
  completedDate   DateTime?
  estimatedCost   Float               @default(0)
  actualCost      Float               @default(0)
  createdBy       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  creator       User?               @relation("WorkOrderCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  items         WorkOrderItem[]
  tasks         ProductionTask[]
  materials     WorkOrderMaterial[]
  qualityChecks QualityCheck[]

  @@unique([companyId, workOrderNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, priority])
  @@index([companyId, customerId])
  @@map("work_orders")
}

model WorkOrderItem {
  id                  String   @id @default(cuid())
  workOrderId         String
  productId           String?
  productNameSnapshot String
  customProductName   String?
  dimensions          String?
  specifications      String?
  quantity            Float    @default(1)
  completedQuantity   Float    @default(0)
  estimatedUnitCost   Float    @default(0)
  actualUnitCost      Float    @default(0)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([productId])
  @@map("work_order_items")
}

model ProductionTask {
  id             String            @id @default(cuid())
  companyId      String
  workOrderId    String
  title          String
  description    String?
  stage          TaskStage         @default(CARPENTRY)
  status         TaskStatus        @default(TODO)
  priority       WorkOrderPriority @default(MEDIUM)
  estimatedHours Float?
  actualHours    Float?
  startTime      DateTime?
  completedTime  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workOrder   WorkOrder                  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  assignments ProductionTaskAssignment[]

  @@index([companyId])
  @@index([workOrderId])
  @@index([companyId, status])
  @@map("production_tasks")
}

model ProductionTaskAssignment {
  id               String   @id @default(cuid())
  productionTaskId String
  workerId         String
  assignedAt       DateTime @default(now())
  assignedBy       String?
  status           String   @default("ASSIGNED")
  notes            String?

  task   ProductionTask @relation(fields: [productionTaskId], references: [id], onDelete: Cascade)
  worker Worker         @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([productionTaskId, workerId])
  @@index([productionTaskId])
  @@index([workerId])
  @@map("production_task_assignments")
}

model WorkOrderMaterial {
  id               String         @id @default(cuid())
  companyId        String
  workOrderId      String
  productId        String
  plannedQuantity  Float          @default(0)
  issuedQuantity   Float          @default(0)
  consumedQuantity Float          @default(0)
  returnedQuantity Float          @default(0)
  unitCost         Float          @default(0)
  status           MaterialStatus @default(PLANNED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([workOrderId])
  @@index([productId])
  @@map("work_order_materials")
}

model QualityCheck {
  id          String        @id @default(cuid())
  companyId   String
  workOrderId String
  status      QualityStatus @default(PENDING)
  checkedBy   String?
  checkedAt   DateTime?
  notes       String?
  issuesFound String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([workOrderId])
  @@map("quality_checks")
}

model WorkerAttendance {
  id        String           @id @default(cuid())
  companyId String
  workerId  String
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  checkIn   DateTime?
  checkOut  DateTime?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
  @@index([companyId])
  @@index([workerId])
  @@index([companyId, date])
  @@map("worker_attendance")
}

// PHASE 7 — FINANCE, PAYMENTS, EXPENSES & CASH FLOW MANAGEMENT ENUMS & MODELS

enum PaymentAccountType {
  CASH
  BANK
  UPI
  CREDIT_CARD
}

enum FinancialTransactionType {
  OPENING_BALANCE
  CUSTOMER_PAYMENT
  SUPPLIER_PAYMENT
  EXPENSE
  ACCOUNT_TRANSFER_IN
  ACCOUNT_TRANSFER_OUT
  REFUND
  OTHER_INCOME
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  OTHER
}

enum ExpenseStatus {
  PAID
  VOID
}

model PaymentAccount {
  id             String             @id @default(cuid())
  companyId      String
  name           String
  type           PaymentAccountType @default(CASH)
  accountNumber  String?
  openingBalance Float              @default(0)
  currentBalance Float              @default(0)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company          Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions     FinancialTransaction[]
  customerPayments CustomerPayment[]
  supplierPayments SupplierPayment[]
  expenses         Expense[]
  transfersFrom    AccountTransfer[]      @relation("TransferFromAccount")
  transfersTo      AccountTransfer[]      @relation("TransferToAccount")

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("payment_accounts")
}

model FinancialTransaction {
  id              String                   @id @default(cuid())
  companyId       String
  accountId       String
  type            FinancialTransactionType
  direction       TransactionDirection
  amount          Float
  referenceType   String?
  referenceId     String?
  description     String?
  transactionDate DateTime                 @default(now())
  createdBy       String?
  createdAt       DateTime                 @default(now())

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account PaymentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  creator User?          @relation("FinancialTxCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, accountId])
  @@index([companyId, transactionDate])
  @@index([companyId, type])
  @@map("financial_transactions")
}

model CustomerPayment {
  id               String        @id @default(cuid())
  companyId        String
  customerId       String?
  saleId           String?
  paymentAccountId String
  amount           Float
  paymentMethod    PaymentMethod @default(CASH)
  referenceNumber  String?
  notes            String?
  paymentDate      DateTime      @default(now())
  createdBy        String?
  createdAt        DateTime      @default(now())

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale           Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  paymentAccount PaymentAccount @relation(fields: [paymentAccountId], references: [id], onDelete: Cascade)
  creator        User?          @relation("CustomerPaymentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, customerId])
  @@index([companyId, saleId])
  @@index([companyId, paymentDate])
  @@map("customer_payments")
}

model SupplierPayment {
  id               String        @id @default(cuid())
  companyId        String
  supplierId       String?
  purchaseId       String?
  paymentAccountId String
  amount           Float
  paymentMethod    PaymentMethod @default(CASH)
  referenceNumber  String?
  notes            String?
  paymentDate      DateTime      @default(now())
  createdBy        String?
  createdAt        DateTime      @default(now())

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier       Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchase       Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  paymentAccount PaymentAccount @relation(fields: [paymentAccountId], references: [id], onDelete: Cascade)
  creator        User?          @relation("SupplierPaymentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, supplierId])
  @@index([companyId, purchaseId])
  @@index([companyId, paymentDate])
  @@map("supplier_payments")
}

model ExpenseCategory {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("expense_categories")
}

model Expense {
  id               String        @id @default(cuid())
  companyId        String
  categoryId       String?
  paymentAccountId String
  title            String
  description      String?
  amount           Float
  expenseDate      DateTime      @default(now())
  paymentMethod    PaymentMethod @default(CASH)
  referenceNumber  String?
  receiptUrl       String?
  status           ExpenseStatus @default(PAID)
  createdBy        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category       ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentAccount PaymentAccount   @relation(fields: [paymentAccountId], references: [id], onDelete: Cascade)
  creator        User?            @relation("ExpenseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, categoryId])
  @@index([companyId, expenseDate])
  @@index([companyId, status])
  @@map("expenses")
}

model AccountTransfer {
  id              String   @id @default(cuid())
  companyId       String
  fromAccountId   String
  toAccountId     String
  amount          Float
  referenceNumber String?
  notes           String?
  transferDate    DateTime @default(now())
  createdBy       String?
  createdAt       DateTime @default(now())

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromAccount PaymentAccount @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   PaymentAccount @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)
  creator     User?          @relation("AccountTransferCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, fromAccountId])
  @@index([companyId, toAccountId])
  @@index([companyId, transferDate])
  @@map("account_transfers")
}


